{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bubblelab.dev/contracts/v1/frame.schema.json",
  "title":"Bubble Lab Frame / Checkpoint",
  "type":"object",
  "additionalProperties":true,
  "required":["contract_version","kind","frame_id","simulation_time_s","manifest","environment","bubbles","surface_meshes","film_regions","junctions","topology"],
  "properties":{
    "contract_version":{"const":"1.0.0"},
    "kind":{"enum":["FRAME","CHECKPOINT"]},
    "frame_id":{"type":"string","minLength":1},
    "simulation_time_s":{"type":"number","minimum":0},
    "manifest":{"$ref":"simulation-manifest.schema.json"},
    "environment":{"$ref":"#/$defs/environment"},
    "bubbles":{"type":"array","items":{"$ref":"#/$defs/bubble"}},
    "surface_meshes":{"type":"array","items":{"$ref":"#/$defs/surfaceMesh"}},
    "film_regions":{"type":"array","items":{"$ref":"#/$defs/filmRegion"}},
    "junctions":{"type":"array","items":{"$ref":"#/$defs/junction"}},
    "topology":{"$ref":"#/$defs/topology"},
    "diagnostics":{"$ref":"#/$defs/diagnostics"},
    "checkpoint_state":{"type":"object","description":"Opaque solver continuation metadata/references; present only when available."}
  },
  "$defs":{
    "vec3":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
    "arrayRef":{
      "type":"object","required":["storage","dtype","shape"],
      "properties":{
        "storage":{"enum":["INLINE","SIDECAR"]},
        "dtype":{"enum":["float32","float64","int32","uint32","uint8"]},
        "shape":{"type":"array","items":{"type":"integer","minimum":0}},
        "values":{"type":"array"},
        "uri":{"type":"string","minLength":1},
        "byte_offset":{"type":"integer","minimum":0},
        "byte_length":{"type":"integer","minimum":0},
        "encoding":{"enum":["raw","npy","npz","zarr","custom"]}
      },
      "allOf":[
        {"if":{"properties":{"storage":{"const":"INLINE"}}},"then":{"required":["values"],"not":{"required":["uri"]}}},
        {"if":{"properties":{"storage":{"const":"SIDECAR"}}},"then":{"required":["uri"],"not":{"required":["values"]}}}
      ],
      "additionalProperties":true
    },
    "environment":{
      "type":"object","required":["gravity_m_s2","ambient_density_kg_m3","ambient_dynamic_viscosity_pa_s"],
      "properties":{
        "gravity_m_s2":{"$ref":"#/$defs/vec3"},
        "ambient_density_kg_m3":{"type":"number","minimum":0},
        "ambient_dynamic_viscosity_pa_s":{"type":"number","minimum":0},
        "wind":{"type":"object","properties":{"velocity_m_s":{"$ref":"#/$defs/vec3"},"description":{"type":"string"}},"additionalProperties":true},
        "flow_metadata":{"type":"object"},
        "boundary_refs":{"type":"array","items":{"type":"string"}}
      },"additionalProperties":true
    },
    "bubble":{
      "type":"object","required":["id","volume_m3","equivalent_radius_m","centroid_m","velocity_m_s","status"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "volume_m3":{"type":"number","exclusiveMinimum":0},
        "equivalent_radius_m":{"type":"number","exclusiveMinimum":0},
        "centroid_m":{"$ref":"#/$defs/vec3"},
        "velocity_m_s":{"$ref":"#/$defs/vec3"},
        "status":{"enum":["ALIVE","RUPTURED","MERGED","SPLIT","REMOVED"]},
        "pressure_pa":{"type":["number","null"]},
        "temperature_k":{"type":["number","null"],"minimum":0},
        "gas_amount_mol":{"type":["number","null"],"minimum":0},
        "gas_species":{"type":["string","null"]},
        "film_material":{"type":["object","null"],"additionalProperties":true}
      },"additionalProperties":true
    },
    "surfaceMesh":{
      "type":"object","required":["id","geometry_role","vertex_count","face_count","vertices","faces"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "geometry_role":{"enum":["OUTER_FILM","SHARED_FILM","PLATEAU_BORDER","BOUNDARY","OTHER"]},
        "owner_bubble_ids":{"type":"array","items":{"type":"string"}},
        "region_labels":{"type":"array","items":{"type":"string"}},
        "vertex_count":{"type":"integer","minimum":0},
        "face_count":{"type":"integer","minimum":0},
        "vertices":{"$ref":"#/$defs/arrayRef"},
        "faces":{"$ref":"#/$defs/arrayRef"},
        "fields":{"type":"object","additionalProperties":{"$ref":"#/$defs/arrayRef"}}
      },"additionalProperties":true
    },
    "filmRegion":{
      "type":"object","required":["id","kind","adjacent","surface_tension_n_m"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "kind":{"enum":["OUTER","SHARED"]},
        "adjacent":{"type":"array","minItems":2,"maxItems":2,"items":{"anyOf":[{"type":"string","minLength":1},{"const":"EXTERIOR"}]}},
        "mesh_id":{"type":["string","null"]},
        "surface_tension_n_m":{"type":"number","minimum":0},
        "thickness":{"type":["object","null"],"additionalProperties":true}
      },"additionalProperties":true
    },
    "junction":{
      "type":"object","required":["id","incident_film_ids"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "incident_film_ids":{"type":"array","minItems":3,"items":{"type":"string"}},
        "geometry":{"$ref":"#/$defs/arrayRef"},
        "measured_angles_deg":{"type":"array","items":{"type":"number","minimum":0,"maximum":180}},
        "measurement_provenance":{"type":"object"}
      },"additionalProperties":true
    },
    "event":{
      "type":"object","required":["id","type","time_s","provenance"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "type":{"enum":["CONTACT_BEGIN","FILM_FORMED","COALESCENCE","RUPTURE","SPLIT","CONTACT_END","BUBBLE_REMOVED"]},
        "time_s":{"type":"number","minimum":0},
        "bubble_ids_before":{"type":"array","items":{"type":"string"}},
        "bubble_ids_after":{"type":"array","items":{"type":"string"}},
        "film_ids":{"type":"array","items":{"type":"string"}},
        "provenance":{"type":"object","required":["source"],"properties":{"source":{"enum":["SOLVER","USER","IMPORT","TEST_FIXTURE"]},"detail":{"type":"string"}},"additionalProperties":true}
      },"additionalProperties":true
    },
    "topology":{
      "type":"object","required":["adjacency","events"],
      "properties":{
        "adjacency":{"type":"array","items":{"type":"object","required":["a","b"],"properties":{"a":{"type":"string"},"b":{"type":"string"},"film_id":{"type":["string","null"]}},"additionalProperties":false}},
        "events":{"type":"array","items":{"$ref":"#/$defs/event"}}
      },"additionalProperties":true
    },
    "diagnostics":{
      "type":"object",
      "properties":{
        "timestep_s":{"type":"number","exclusiveMinimum":0},
        "nonlinear_iterations":{"type":"integer","minimum":0},
        "linear_iterations":{"type":"integer","minimum":0},
        "residuals":{"type":"object","additionalProperties":{"type":"number"}},
        "max_relative_volume_error":{"type":"number","minimum":0},
        "mesh_quality":{"type":"object"},
        "compute_time_s":{"type":"number","minimum":0}
      },"additionalProperties":true
    }
  }
}
